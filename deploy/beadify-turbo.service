[Unit]
Description=Beadify Turbo static web server
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/beadify-turbo
ExecStart=/usr/bin/node /opt/beadify-turbo/serve.cjs
Environment=PORT=8080
Environment=BEADIFY_HOST=0.0.0.0
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
